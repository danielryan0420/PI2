{
  "name": "physical-inventory-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "node-sqlite3-wasm": "^0.8.55",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {

    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
